FLOWFORGE_MODEL_BASE_URL=http://localhost:8001/v1
FLOWFORGE_MODEL_NAME=qwen3-4b-local
FLOWFORGE_MODEL_API_TOKEN=local-model
FLOWFORGE_MODEL_RESPONSE_FORMAT=json_object
FLOWFORGE_MODEL_TIMEOUT_SECONDS=120
FLOWFORGE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FLOWFORGE_DATABASE_URL=sqlite+aiosqlite:///./flowforge.db
# Leave empty for the single-process development bus. Set for multi-instance development.
FLOWFORGE_REDIS_URL=
FLOWFORGE_REALTIME_CHANNEL_PREFIX=flowforge
FLOWFORGE_PRESENCE_TTL_SECONDS=45
FLOWFORGE_EMBEDDED_WORKER_ENABLED=true
FLOWFORGE_JOB_POLL_SECONDS=0.5
FLOWFORGE_JOB_RESULT_RETENTION_DAYS=7
FLOWFORGE_JOB_HISTORY_RETENTION_DAYS=90
FLOWFORGE_ATTACHMENT_UPLOAD_EXPIRY_HOURS=24
FLOWFORGE_ARTIFACT_RETENTION_DAYS=7
FLOWFORGE_MAX_ARTIFACT_BYTES=52428800
FLOWFORGE_REQUEST_RATE_LIMIT=180
FLOWFORGE_REQUEST_RATE_WINDOW_SECONDS=60
FLOWFORGE_RATE_LIMIT_TRUST_FORWARDED_FOR=false
FLOWFORGE_METRICS_API_KEY=replace-with-a-separate-random-64-character-metrics-key
# Local files are written outside the relational database. Production must use s3.
FLOWFORGE_STORAGE_BACKEND=local
FLOWFORGE_STORAGE_LOCAL_PATH=.flowforge-storage
FLOWFORGE_STORAGE_BUCKET=flowforge-attachments
FLOWFORGE_DEPLOYMENT_REGION=us-central
FLOWFORGE_ATTACHMENT_SCAN_MODE=disabled
FLOWFORGE_AUTH_SECRET=replace-with-a-random-64-character-secret
FLOWFORGE_AUTH_SESSION_DAYS=30
FLOWFORGE_AUTH_COOKIE_SECURE=false
FLOWFORGE_INTERNAL_API_KEY=replace-with-a-separate-random-64-character-owner-key
FLOWFORGE_FRONTEND_URL=http://127.0.0.1:3000
FLOWFORGE_INVITATION_EXPIRY_DAYS=7
# Use console for local setup-link previews. Set to smtp in production.
FLOWFORGE_EMAIL_DELIVERY_MODE=console
FLOWFORGE_SMTP_HOST=
FLOWFORGE_SMTP_PORT=587
FLOWFORGE_SMTP_USERNAME=
FLOWFORGE_SMTP_PASSWORD=
FLOWFORGE_SMTP_FROM_EMAIL=FlowForge <no-reply@example.com>
FLOWFORGE_SMTP_USE_TLS=true
