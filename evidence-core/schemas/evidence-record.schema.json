{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verifiable-evidence-core:schema:evidence-record:1.0",
  "title": "Canonical evidence record",
  "type": "object",
  "required": ["evidence_id", "source", "kind", "observed_at", "collected_at", "payload", "metadata"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "collected_at": {"type": "string", "format": "date-time"},
    "control_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "parent_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "document_ref": {"type": ["string", "null"]},
    "payload": {"type": "object"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
